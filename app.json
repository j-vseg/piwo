{
  "expo": {
    "name": "Piwo",
    "slug": "piwo",
    "version": "2.3.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "piwo",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.scoutingmierlo.piwo",
      "googleServicesFile": "./google-services/google-services.json",
      "versionCode": 5
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffd9ad",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "backgroundColor": "#2A2117"
          },
          "imageWidth": 124
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/crimson-pro/600SemiBold/CrimsonPro_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/poppins/400Regular/Poppins_400Regular.ttf",
            "node_modules/@expo-google-fonts/poppins/600SemiBold/Poppins_600SemiBold.ttf"
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}